# GEMINI_API_KEY: Required for server-side Gemini RAG & embeddings (@google/genai).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Optional for GitHub Pages connecting to a separately hosted Business IQ Express server:
# VITE_API_BASE_URL=https://your-business-iq-server.example.com
# CORS_ALLOWED_ORIGIN=https://your-username.github.io

# Optional free-tier Gemini model routing overrides (server-side only):
# GEMINI_GENERATION_MODELS=gemini-3.1-flash-lite,gemini-4-hydrogen
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional Production External Services (for post-prototype deployment):
# OPENAI_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
